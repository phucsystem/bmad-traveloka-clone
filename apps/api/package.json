    "@repo/shared": "workspace:*",
    "better-auth": "^1.5.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.21.0",
    "ioredis": "^5.3.2",
    "nestjs-pino": "^4.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.1.3",
